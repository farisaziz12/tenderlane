{
  "name": "tenderlane-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Headless, typed checkout routing across payment providers. Alpha.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "example": "turbo run build --filter='./packages/*' && pnpm --filter nextjs-multi-psp-checkout-example dev",
    "docs": "cd docs-site && pnpm build",
    "docs:dev": "cd docs-site && pnpm dev",
    "docs:serve": "cd docs-site && pnpm preview",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "lint:fix": "oxlint --fix",
    "test:build": "pnpm -r --filter './packages/*' exec publint --strict",
    "test:workspace": "sherif",
    "check": "pnpm test:hidden-code && pnpm lint && pnpm test:workspace && pnpm build && pnpm typecheck && pnpm test && pnpm test:build",
    "test:hidden-code": "node tools/check-hidden-code.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "sherif": "^1.13.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
