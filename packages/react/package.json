{
  "name": "@tenderlane/react",
  "version": "0.1.0-alpha.2",
  "description": "React bindings for Tenderlane payment orchestration",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farisaziz12/tenderlane.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/farisaziz12/tenderlane#readme",
  "bugs": "https://github.com/farisaziz12/tenderlane/issues",
  "author": "Faris Aziz",
  "keywords": [
    "payments",
    "checkout",
    "react",
    "hooks",
    "tenderlane"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tenderlane/client": "workspace:*",
    "@tenderlane/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.1.0",
    "jsdom": "^25.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
