---
import { packageVersion } from '../lib/version';
const repository = 'https://github.com/farisaziz12/tenderlane';
---

<footer class="footer">
  <div class="container footer-row">
    <span>Tenderlane {packageVersion} · MIT · alpha proof of concept, not production-ready</span>
    <span>
      <a href={repository}>GitHub</a> · <a href={`${repository}/issues`}>Issues</a>
    </span>
  </div>
  <div class="container footer-note">
    Tenderlane is an independent project. It is not affiliated with or endorsed by TanStack, Stripe
    or Polar.
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line-1);
    padding: 28px 0 40px;
    margin-top: 80px;
    color: var(--text-2);
    font-size: 13px;
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .footer-note {
    margin-top: 10px;
    color: var(--text-3);
  }
  a {
    color: var(--text-1);
  }
</style>
