---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const pages = (await getCollection('docs'))
  .map((page) => ({ label: page.data.title, slug: page.id, order: page.data.order }))
  .sort((left, right) => left.order - right.order);
const groups = [{ label: 'Docs', items: pages }];
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  headings={headings}
  groups={groups}
  breadcrumb={{ label: entry.data.title, section: 'Docs' }}
>
  <h1>{entry.data.title}</h1>
  <p class="t-body-lg" style="margin:0 0 32px;color:var(--text-1);max-width:700px">
    {entry.data.description}
  </p>
  <Content />
</DocsLayout>
